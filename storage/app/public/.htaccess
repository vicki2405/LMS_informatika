# Security Hardening: Prevent execution of scripts in the upload storage directory
<IfModule mod_authz_core.c>
    <FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phps|phar|inc|sh|pl|cgi|py|asp|aspx|exe|bat|cmd|env|htaccess|user\.ini)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phps|phar|inc|sh|pl|cgi|py|asp|aspx|exe|bat|cmd|env|htaccess|user\.ini)$">
        Order Allow,Deny
        Deny from all
    </FilesMatch>
</IfModule>

# Turn off PHP execution in this directory if mod_php is present
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Disable script execution via handler overrides
<IfModule mod_mime.c>
    RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .cgi .pl .py .sh
    RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .cgi .pl .py .sh
</IfModule>

# Prevent directory indexing
Options -Indexes -ExecCGI
